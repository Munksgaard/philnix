Require full-document support before enabling semantic-token highlighting.
Servers such as dhall-lsp-server advertise a legend without supporting full
requests.  Adapted to the standalone Eglot package's source layout.

--- a/eglot.el
+++ b/eglot.el
@@ -4993,7 +4993,7 @@
   :global nil
   (setq eglot--semtok-state nil)
   (cond (eglot-semantic-tokens-mode
-         (if (not (eglot-server-capable :semanticTokensProvider))
+         (if (not (eglot-server-capable :semanticTokensProvider :full))
              (eglot-semantic-tokens-mode -1)
            (add-hook 'eglot--send-changes-hook
                      #'eglot--semtok-after-send-changes)
